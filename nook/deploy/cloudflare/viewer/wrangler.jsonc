{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nook-viewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // 読む画面の app.js / app.css(Python 版のローカル閲覧画面とは別のファイル)。
  // run_worker_first により静的ファイルも Access JWT の検証を通す。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "NOOK_BUCKET", "bucket_name": "nook-data" }],
  // 学習データ(お気に入り・メモ・用語辞書など、#13)。テーブルは migrations/ で管理する
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nook-study",
      "database_id": "45492da1-413c-4031-85c5-8359eca133f5",
      "migrations_dir": "migrations"
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // Python 側(GitHub Actions)と同じ provider:model 形式。Worker は google-gla のみ対応。
    "LLM_MODEL": "google-gla:gemini-flash-lite-latest",
    // タブに出す collector。カンマ区切りで、この順に並べる。
    "VIEWER_SERVICES": "tech_news,jp_tech_news,tech_feed,hacker_news,product_hunt,github_trending,paper_summarizer,arxiv_news,reddit_explorer",
    "GITHUB_REPOSITORY": "shiyow5/nook",
    "GITHUB_WORKFLOW": "collect.yml",
    "GITHUB_REF": "main",
    // Zero Trust のチーム名(<team>.cloudflareaccess.com の <team>)と Access アプリの AUD。
    "ACCESS_TEAM_DOMAIN": "shiyow-zt",
    "ACCESS_AUD": "f2557568746f7de5580c1cddba50997ff47766ee598cc9ae881c879c26430d61"
  }
  // secrets(wrangler secret put で登録): GOOGLE_API_KEY, GITHUB_TOKEN
}
